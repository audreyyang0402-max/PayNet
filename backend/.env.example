# Copy to backend/.env for local work. On Render, set the same keys under Environment.
# Never commit the real .env.

# Postgres connection (Supabase > Connect > Session pooler URI)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Signs login tokens. Random, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Supabase project (Settings > API)
SUPABASE_URL=https://PROJECT.supabase.co
# Public key: used to send and check email verification codes
SUPABASE_PUBLISHABLE_KEY=
# Secret key: used to upload images. Backend only. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Storage buckets (create both in Supabase > Storage)
# Public bucket: DuitNow QR codes, menu photos, event banners
SUPABASE_PUBLIC_BUCKET=uploads
# PRIVATE bucket: customer payment receipts (served through 1-hour signed links)
SUPABASE_RECEIPT_BUCKET=receipts

# "Your food is ready" emails (Gmail SMTP; use a Google app password, not the normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
